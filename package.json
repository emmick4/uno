{
  "name": "uno-online",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/gamemodes",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @uno/client\" \"npm run dev -w @uno/server\"",
    "dev:client": "npm run dev -w @uno/client",
    "dev:server": "npm run dev -w @uno/server",
    "build": "npm run build -w @uno/shared && npm run build -w @uno/gamemodes && npm run build -w @uno/server && npm run build -w @uno/client",
    "typecheck": "tsc --build",
    "lint": "eslint packages/*/src",
    "deploy:server": "npm run deploy -w @uno/server",
    "deploy:client": "vercel --prod",
    "deploy": "npm run deploy:server && npm run deploy:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
